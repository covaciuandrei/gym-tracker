rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // helper function
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Canonical product writes use `created_by`; older records may still use
    // `createdBy`. Resolve either shape so owners can migrate legacy records.
    function supplementProductOwner(data) {
      return 'created_by' in data
        ? data.created_by
        : ('createdBy' in data ? data.createdBy : null);
    }

    // App config: public read (the version/maintenance gate runs before auth).
    // Writes only via Firebase Console / admin SDK.
    match /appConfig/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Users collection: Strict ownership
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Global Ingredients: reserved for a future shared catalog. Client writes
    // are blocked; seed/manage it through the Firebase Console or Admin SDK.
    match /ingredients/{ingredientId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Supplement Products:
    // Read: All authenticated users
    // Create: authenticated users may create only records owned by themselves.
    // Update/Delete: only the existing owner; ownership cannot be transferred.
    match /supplementProducts/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && supplementProductOwner(request.resource.data) == request.auth.uid;
      allow update: if isSignedIn()
        && supplementProductOwner(resource.data) == request.auth.uid
        && supplementProductOwner(request.resource.data) == request.auth.uid;
      allow delete: if isSignedIn()
        && supplementProductOwner(resource.data) == request.auth.uid;
    }
  }
}
